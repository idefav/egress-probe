[Unit]
Description=Private multi-protocol egress observer
After=network-online.target
Wants=network-online.target

[Service]
User=egress-probe
Group=egress-probe
ExecStart=/usr/local/bin/egress-probe-server -config /etc/egress-probe/config.json
Restart=on-failure
RestartSec=5
StateDirectory=egress-probe
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
